{
  "name": "@self-sown/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "lint": "tsc --noEmit && pnpm -C ../.. exec eslint apps/mobile",
