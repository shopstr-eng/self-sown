    "test": "node scripts/navigation-query-smoke.mjs && pnpm --dir ../.. exec jest __tests__/mobile --runInBand",
    "verify:ios-entitlements": "node scripts/verify-ios-entitlements.mjs",
    "submit:ios": "node scripts/submit-ios.mjs",
    "appstore:status": "node scripts/appstore-submission.mjs status",
    "appstore:screenshots": "node scripts/appstore-submission.mjs screenshots",
    "appstore:attachment": "node scripts/appstore-submission.mjs attachment",
    "appstore:submit": "node scripts/appstore-submission.mjs submit",
    "appstore:listing:check": "node scripts/appstore-listing.mjs check",
    "appstore:listing:apply": "node scripts/appstore-listing.mjs apply"
  },
  "dependencies": {
