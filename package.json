{
  "name": "self-sown",
  "version": "0.10.3",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.4.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "bash scripts/dev-server.sh",
    "dev:hot": "NODE_OPTIONS='--max-old-space-size=1024' next dev -p 5000",
    "dev:web": "pnpm run dev",
    "dev:mobile": "pnpm --filter @self-sown/mobile dev",
    "build": "next build",
    "build:web": "next build",
    "build:deploy": "bash scripts/deploy-build.sh",
    "start:deploy": "node .next/standalone/server.js",
    "build:all": "turbo run build --filter=@self-sown/mobile --filter=@self-sown/domain --filter=@self-sown/nostr --filter=@self-sown/api-client",
    "start": "node scripts/start-standalone.mjs",
    "dev:prod": "NODE_OPTIONS='--max-old-space-size=2048' next build && PORT=5000 node scripts/start-standalone.mjs",
    "lint": "pnpm run lint:web && turbo run lint --filter=@self-sown/mobile --filter=@self-sown/domain --filter=@self-sown/nostr --filter=@self-sown/api-client",
    "lint:web": "eslint . --ext .ts,.tsx",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit --incremental false",
    "typecheck": "pnpm run typecheck:web && turbo run typecheck --filter=@self-sown/mobile --filter=@self-sown/domain --filter=@self-sown/nostr --filter=@self-sown/api-client",
    "typecheck:web": "tsc --noEmit --incremental false",
    "lint-all": "pnpm run typecheck:web && pnpm run lint:web",
    "test": "jest",
    "test:web": "jest",
    "test:all": "pnpm run test:web && turbo run test --filter=@self-sown/mobile --filter=@self-sown/domain --filter=@self-sown/nostr --filter=@self-sown/api-client",
    "test:ci": "jest --ci --runInBand",
    "test:coverage": "jest --coverage --ci --runInBand",
    "test:integration": "RUN_TESTCONTAINERS=1 jest utils/db/__tests__/db-service.test.ts __tests__/pages/api/ucp-checkout-escalation-roundtrip-db.test.ts __tests__/mcp/pending-lightning-quotes-db.test.ts --runInBand",
    "test:db": "RUN_TESTCONTAINERS=1 jest \"utils/(db|email)/__tests__/.*-db\\.test\\.ts$\" --runInBand",
    "test:self-host-build": "RUN_SELF_HOST_BUILD=1 jest utils/self-host/__tests__/export-bundle-full-build.test.ts --runInBand",
    "test:build-scripts": "bash scripts/dev-server.test.sh && bash scripts/deploy-build.test.sh",
    "test:watch": "jest --watch",
    "prepare": "husky",
    "pre-commit": "node scripts/run-staged-checks.mjs"
  },
